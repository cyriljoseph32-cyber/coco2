---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../data/site";
import { EXPERIENCES } from "../../data/content";

export function getStaticPaths() {
  return EXPERIENCES.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
const similar = EXPERIENCES.filter((x) => x.slug !== e.slug).slice(0, 3);
const schema = [{
  "@type": "TouristAttraction",
  name: e.title,
  description: e.desc,
  isAccessibleForFree: e.price.toLowerCase().includes("free"),
}];
---
<Base
  title={`${e.title} — Koh Samui | Coco`}
  description={e.desc}
  schema={schema}
>
  <div class="mx-auto max-w-[820px] px-5 pb-24 pt-8 sm:px-8">
    <a href="/explore" class="text-[12.5px] font-semibold text-foam hover:underline">← Back to Discover</a>

    <div class="mt-5 -mx-5 grid grid-cols-1 gap-[3px] sm:-mx-8 sm:grid-cols-[1.6fr_1fr]" aria-hidden="true">
      <div class="flex h-56 items-center justify-center bg-ink-2 text-[11px] text-white/30 sm:h-[300px]">Photo — {e.title}</div>
      <div class="hidden gap-[3px] sm:grid sm:grid-rows-2">
        <div class="flex items-center justify-center bg-ink-2 text-[10px] text-white/25">Photo</div>
        <div class="flex items-center justify-center bg-ink-2 text-[10px] text-white/25">Photo</div>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-foam">{e.emoji} Signature experience</p>
        <h1 class="font-display mt-2 text-[clamp(1.8rem,4vw,2.4rem)] font-medium leading-tight text-white">{e.title}</h1>
        <p class="mt-1.5 text-[13.5px] text-white/50">Koh Samui</p>
      </div>
      <div class="text-right">
        <p class="font-display text-[19px] font-bold text-white">{e.price}</p>
        <p class="mt-0.5 text-[11px] text-white/45">indicative — confirm with operator</p>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-2.5">
      <button type="button" data-coco-q={e.q} class="cursor-pointer rounded-xl bg-teal px-5 py-3 text-[13.5px] font-semibold text-white transition hover:bg-teal-deep">💬 {e.cta}</button>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 border-y hairline py-5 sm:grid-cols-3">
      <div>
        <p class="text-[10.5px] font-bold uppercase tracking-[0.1em] text-white/40">Best time</p>
        <p class="mt-1.5 text-[13.5px] font-semibold text-white">{e.bestTime}</p>
      </div>
      <div>
        <p class="text-[10.5px] font-bold uppercase tracking-[0.1em] text-white/40">Travel time</p>
        <p class="mt-1.5 text-[13.5px] font-semibold text-white">{e.travelTime}</p>
      </div>
      <div>
        <p class="text-[10.5px] font-bold uppercase tracking-[0.1em] text-white/40">Booking</p>
        <p class="mt-1.5 text-[13.5px] font-semibold text-white">{e.booking}</p>
      </div>
    </div>

    <div class="mt-8">
      <h2 class="font-display text-[16px] font-bold text-white">Why Coco recommends it</h2>
      <p class="mt-2.5 max-w-[64ch] text-[14px] leading-relaxed text-white/60">{e.desc}</p>
    </div>

    {e.tips && e.tips.length > 0 && (
      <div class="mt-6">
        <h2 class="font-display text-[16px] font-bold text-white">Local tips</h2>
        <div class="mt-2.5 flex flex-col gap-2">
          {e.tips.map((t) => (
            <p class="text-[13.5px] leading-relaxed text-white/60">→ {t}</p>
          ))}
        </div>
      </div>
    )}

    <div class="mt-10">
      <p class="sec-num mb-3.5">SIMILAR PICKS</p>
      <div class="grid gap-3 sm:grid-cols-3">
        {similar.map((s) => (
          <a href={`/experiences/${s.slug}`} class="rounded-2xl border hairline bg-ink-2 p-4 transition hover:border-foam/40">
            <span class="text-2xl" aria-hidden="true">{s.emoji}</span>
            <span class="mt-2 block text-[13px] font-bold text-white">{s.title}</span>
            <span class="mt-1 block text-[11px] text-white/45">{s.price}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>
