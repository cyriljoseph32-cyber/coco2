---
import Base from "../layouts/Base.astro";
import Split from "../layouts/Split.astro";
import { CATEGORIES, EXPERIENCES, GUIDE } from "../data/content";
import { BEACHES } from "../data/beaches";

const hero = BEACHES.find((b) => b.name === "Lipa Noi")!;
const sideStack = ["kamalaya-wellness", "ang-thong", "fishermans-village-friday"]
  .map((slug) => EXPERIENCES.find((e) => e.slug === slug)!);
const rowStack = ["pig-island", "sunset-cruise"].map((slug) => EXPERIENCES.find((e) => e.slug === slug)!);
const flagship = EXPERIENCES.find((e) => e.slug === "sail-rock")!;
const gettingAround = GUIDE.find((g) => g.title === "Getting Around")!;

const chips = [
  { label: "🏨 Hotels by zone", q: "Which zone of Koh Samui should I stay in — compare Chaweng, Bophut, Maenam and Lamai?" },
  { label: "🛕 Temples", q: "Best temples and cultural sites in Koh Samui to visit?" },
  { label: "🌙 Nightlife", q: "What is the nightlife like in Koh Samui — beach clubs, bars, clubs?" },
  { label: "🎣 Fishing", q: "Best fishing charters in Koh Samui — deep sea, half day, squid fishing?" },
];
const schema = [{
  "@type": "ItemList",
  name: "Koh Samui categories covered by Coco",
  itemListElement: CATEGORIES.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name })),
}];
---
<Base
  title="Discover Koh Samui — Hotels, Diving, Food, Tours & More | Coco"
  description="Every side of Koh Samui in one place: 40+ hotels, 15+ dive sites, 50+ restaurants, sea tours, wellness, nightlife, temples and transport — each one a live conversation with Coco."
  chips={chips}
  schema={schema}
>
  <Split>
    <section class="py-14" aria-labelledby="h1">
      <p class="sec-num mb-4">DISCOVER</p>
      <h1 id="h1" class="font-display max-w-[16ch] text-[clamp(2rem,5vw,3.4rem)] font-medium leading-[1.08] tracking-[-0.02em] text-white">
        Find your Samui.
      </h1>

      <div class="mt-6 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]" aria-label="Categories">
        {CATEGORIES.map((c, i) => (
          <button type="button" data-coco-q={c.q}
            class:list={["shrink-0 cursor-pointer whitespace-nowrap rounded-lg px-3.5 py-2 text-[12px] font-semibold transition",
              i === 0 ? "bg-white text-ink" : "border hairline text-white/70 hover:text-white"]}>
            {c.emoji} {c.name}
          </button>
        ))}
      </div>
    </section>

    <!-- Decorative island illustration — brand flourish, not a real map -->
    <section class="relative overflow-hidden rounded-2xl border hairline bg-ink-2 py-10" aria-hidden="true">
      <svg width="100%" height="180" viewBox="0 0 600 180" class="mx-auto block opacity-80">
        <path transform="translate(230,-70) scale(0.85)" d="M135 14 C190 20 232 60 244 120 C256 182 232 240 190 276 C160 300 120 312 92 292 C58 268 30 226 22 176 C14 122 34 70 78 38 C96 24 116 12 135 14 Z" fill="none" stroke="#a7d9c9" stroke-width="2" opacity="0.5"/>
      </svg>
      <div class="absolute inset-x-0 bottom-4 flex justify-center px-4">
        <div class="rounded-xl bg-ink/90 px-5 py-3 text-center backdrop-blur">
          <p class="text-[12.5px] font-semibold text-white">Everything Coco knows about the island</p>
          <p class="mt-1 max-w-[36ch] text-[11.5px] text-white/50">Ask Coco anything — a beach, a dive, a market night — and get a real, local answer.</p>
        </div>
      </div>
    </section>

    <!-- ══ DISCOVER GRID (cream editorial surfaces) ══ -->
    <section class="-mx-5 mt-6 bg-paper px-5 py-10 sm:-mx-8 sm:px-8 lg:-mx-10 lg:px-10 xl:mx-0 xl:rounded-3xl xl:px-8" aria-label="Recommendations">
      <div class="grid gap-4 lg:grid-cols-[1.4fr_1fr]">
        <a href="/beaches" class="block overflow-hidden rounded-2xl text-white" style={`background:linear-gradient(160deg,${hero.grad[0]},${hero.grad[1]})`}>
          <div class="flex h-40 items-end p-5" aria-hidden="true">
            <span class="text-[10px] font-bold uppercase tracking-[0.1em] text-white/70">Photo — {hero.name} at golden hour</span>
          </div>
          <div class="bg-paper-ink/90 p-5">
            <p class="text-[10.5px] font-bold uppercase tracking-[0.12em] text-sand">Perfect for sunset</p>
            <p class="font-display mt-1.5 text-[19px] font-bold">{hero.name} Beach</p>
            <p class="mt-1.5 max-w-[42ch] text-[12.5px] leading-relaxed text-white/60">{hero.desc}</p>
          </div>
        </a>

        <div class="flex flex-col gap-3">
          {sideStack.map((e) => (
            <a href={`/experiences/${e.slug}`} class="flex items-center gap-3.5 rounded-2xl border hairline-paper bg-white p-4">
              <span class="grid size-14 shrink-0 place-items-center rounded-xl bg-paper-2 text-2xl" aria-hidden="true">{e.emoji}</span>
              <span class="min-w-0">
                <span class="block truncate font-display text-[14.5px] font-bold text-paper-ink">{e.title}</span>
                <span class="mt-0.5 block truncate text-[11.5px] text-paper-ink-soft/80">{e.price}</span>
              </span>
            </a>
          ))}
        </div>
      </div>

      <div class="mt-4 grid gap-4 lg:grid-cols-[1fr_1.4fr]">
        <div class="flex flex-col gap-3">
          {rowStack.map((e) => (
            <a href={`/experiences/${e.slug}`} class="flex items-center gap-3.5 rounded-2xl border hairline-paper bg-white p-4">
              <span class="grid size-14 shrink-0 place-items-center rounded-xl bg-paper-2 text-2xl" aria-hidden="true">{e.emoji}</span>
              <span class="min-w-0">
                <span class="block truncate font-display text-[14.5px] font-bold text-paper-ink">{e.title}</span>
                <span class="mt-0.5 block truncate text-[11.5px] text-paper-ink-soft/80">{e.price}</span>
              </span>
            </a>
          ))}
        </div>
        <a href={`/experiences/${flagship.slug}`} class="flex items-center overflow-hidden rounded-2xl bg-gradient-to-br from-teal to-teal-deep text-white">
          <div class="p-6">
            <p class="text-[10.5px] font-bold uppercase tracking-[0.12em] text-foam">Best for diving</p>
            <p class="font-display mt-1.5 text-[20px] font-bold">{flagship.title}</p>
            <p class="mt-2 max-w-[38ch] text-[12.5px] leading-relaxed text-white/70">{flagship.desc}</p>
          </div>
        </a>
      </div>

      <div class="mt-4 rounded-2xl border hairline-paper bg-white p-5" aria-label="Getting around">
        <p class="text-[10.5px] font-bold uppercase tracking-[0.1em] text-teal-deep">Getting around</p>
        <p class="mt-2 text-[12.5px] leading-relaxed text-paper-ink-soft">{gettingAround.text}</p>
      </div>
    </section>

    <section class="border-t hairline py-12" aria-label="Deeper guides">
      <div class="grid gap-3 sm:grid-cols-3">
        <a href="/beaches" class="rounded-2xl border hairline bg-ink-2 p-5 transition hover:border-foam/40"><span class="block text-[15px] font-bold text-white">🏖️ Beaches</span><span class="mt-1 block text-[12.5px] text-white/45">All 12, by vibe</span></a>
        <a href="/experiences" class="rounded-2xl border hairline bg-ink-2 p-5 transition hover:border-foam/40"><span class="block text-[15px] font-bold text-white">✨ Experiences</span><span class="mt-1 block text-[12.5px] text-white/45">The must-do six</span></a>
        <a href="/guide" class="rounded-2xl border hairline bg-ink-2 p-5 transition hover:border-foam/40"><span class="block text-[15px] font-bold text-white">🧭 Practical</span><span class="mt-1 block text-[12.5px] text-white/45">Money, ferries, safety</span></a>
      </div>
    </section>
  </Split>
</Base>
